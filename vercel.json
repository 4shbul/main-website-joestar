{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/ai-chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.joestarpeptides.com/api/:path*"
    }
  ]
}
